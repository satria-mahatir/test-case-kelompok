								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"buku_id\": 1,\n    \"nama_peminjam\": \"Ahmad Fauzi\",\n    \"nis\": \"2024001\",\n    \"tanggal_pinjam\": \"2026-07-20\",\n    \"tanggal_kembali_rencana\": \"2026-07-27\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/peminjaman",
							"host": ["{{base_url}}"],
							"path": ["peminjaman"]
						},
						"description": "Mencatat transaksi peminjaman buku baru.\n\nProses otomatis:\n- Mengecek ketersediaan stok buku\n- Mengurangi stok buku sebanyak 1\n- Menggunakan database transaction untuk keamanan data\n\nField wajib:\n- buku_id (integer, harus ada di tabel bukus)\n- nama_peminjam (string, max:150)\n- nis (string, max:30)\n- tanggal_pinjam (date, format: YYYY-MM-DD)\n- tanggal_kembali_rencana (date, harus >= tanggal_pinjam)\n\nResponse 422 jika stok buku habis."
					},
					"response": []
				},
				{
					"name": "Detail Peminjaman",
					"request": {
						"method": "GET",
						"header": [
